{
  "name": "stocky",
  "version": "0.1.0",
  "description": "Crypto market data collector, backtester and paper trader, plus a research-only stock digest",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "up": "tsx src/supervisor.ts",
    "backtest": "tsx src/backtest/cli.ts",
    "paper": "tsx src/paper/cli.ts",
    "reconcile": "tsx src/paper/reconcile.ts",
    "digest": "tsx src/digest.ts",
    "walkforward": "tsx src/backtest/walkforward.ts",
    "research": "tsx src/research/cli.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@duckdb/node-api": "^1.5.5-r.3",
    "lightweight-charts": "^5.2.0",
    "pino": "^10.3.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
